# 企业微信智能编辑机器人配置
# 复制此文件为 .env 并填入真实值
#
# 从企业微信后台「应用管理」→「智能编辑机器人」→「API 配置」页面获取

# ========== 必填 ==========
# Bot ID（智能机器人的唯一标识）
WECOM_BOT_ID=aib_elfuOYu7fiRWpt11RxkxNPjqLubpc8i1

# Secret（长连接专用密钥）
WECOM_BOT_SECRET=9rFe7C7cPKSgCZM7Un1t0fge2S4iaHy4It2qwVgEDcv

# ========== 可选 ==========
# WebSocket 连接地址（留空使用默认官方地址）
# WECOM_WS_URL=

# 心跳间隔（毫秒，默认 30000 = 30 秒）
# WECOM_HEARTBEAT_INTERVAL=30000

# 重连基础延迟（毫秒，默认 1000 = 1 秒）
# WECOM_RECONNECT_INTERVAL=1000

# 最大重连次数（默认 10，-1 表示无限重连）
# WECOM_MAX_RECONNECT_ATTEMPTS=10

# 场景标识
# WECOM_SCENE=1

# 插件版本号
# WECOM_PLUG_VERSION=1.0.0

# ========== 行为配置 ==========
# 是否开启流式回复（true/false）
# ENABLE_STREAM_REPLY=true

# 流式回复初始提示语
# STREAM_THINKING_TEXT=正在思考中...

# 欢迎语文本（支持 Markdown）
# WELCOME_TEXT=您好！我是智能助手，有什么可以帮您的吗？\n\n您可以输入 /help 查看支持的命令。

# 是否启用命令系统（true/false）
# ENABLE_COMMANDS=true

# 是否启用 AI 回复（需要配置外部 AI 服务）
# ENABLE_AI_REPLY=false
